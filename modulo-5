Para poder cumplir con al menos una fila en cada consulta, modifiqué M3 para creat una nueva tabla de regiones con algunos datos nuevos

Consulta 1 — Vista base del proyecto (INNER JOIN)
-- Propósito: construir la vista única que alimentará Power BI, con cada venta detallada con el nombre del cliente, el producto, su categoría y la región.

SELECT
v.fecha_venta,
v.id_cliente,
c.nombre     AS nombre_cliente,
p.nombre_producto     AS producto,
cat.nombre_categoria   AS categoria,
r.nombre_region      AS region,
v.cantidad,
v.precio_unitario,
v.cantidad * v.precio_unitario AS total_venta
FROM ventas v
INNER JOIN clientes   c   ON v.id_cliente  = c.id_cliente
INNER JOIN productos  p   ON v.id_producto = p.id_producto
INNER JOIN categorias cat ON p.id_categoria = cat.id_categoria
INNER JOIN regiones   r   ON v.id_region   = r.id_region
ORDER BY v.fecha_venta;

-- Hallazgo: La región Cuyo y la categoría Computación aparecen como las de mayor peso

Consulta 2 — Clientes sin ventas (LEFT JOIN)
-- Propósito: detectar clientes registrados que nunca compraron, para que el área de CRM pueda contactarlos.

SELECT
c.nombre,
c.email,
c.fecha_registro
FROM clientes c
LEFT JOIN ventas v ON c.id_cliente = v.id_cliente
WHERE v.id_venta IS NULL;
 
-- Hallazgo: 2 de los 7 clientes registrados nunca compraron (Diego Mora y Sofía Blanco). Ambos se registraron en marzo 2024: son altas recientes sin primera compra, un objetivo claro de reactivación para CRM.


Consulta 3
-- Propósito: identificar artículos del catálogo sin movimiento, para que el área de producto evalúe discontinuarlos o impulsarlos.

SELECT
p.nombre_producto,
cat.nombre_categoria AS categoria,
p.precio
FROM productos p
LEFT JOIN ventas v   ON p.id_producto = v.id_producto
INNER JOIN categorias cat ON p.id_categoria = cat.id_categoria
WHERE v.id_venta IS NULL;

-- Hallazgo: 2 de los 8 productos del catálogo no registran ninguna venta (Webcam HD 1080 y Parlante Bluetooth), ambos de bajo precio. Se debe decidir si los impulsa con promoción o los saca del catálogo.


Consulta 4 
-- Propósito: comparar el total facturado entre la primera y la segunda quincena de marzo.

SELECT periodo, SUM(total) AS total_periodo
FROM (
    SELECT fecha_venta,
           cantidad * precio_unitario AS total,
           'Primera quincena' AS periodo
    FROM ventas
    WHERE fecha_venta <= '2024-03-10'
    UNION ALL
    SELECT fecha_venta,
           cantidad * precio_unitario AS total,
           'Segunda quincena' AS periodo
    FROM ventas
    WHERE fecha_venta > '2024-03-10'
) AS consolidado
GROUP BY periodo
ORDER BY total_periodo DESC;


-- Hallazgo: la primera quincena facturó 3.620 contra 2.824 de la segunda. El arranque del mes concentró más ventas de alto valor (laptops)
